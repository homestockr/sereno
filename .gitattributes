# Normalise to LF in the repo, check out LF by default.
* text=auto eol=lf

# These two are run by Windows, not by Node, and must keep CRLF on disk:
# cmd.exe is unreliable with LF-only batch files, and emit.cmd sits in the
# critical path of every Claude Code tool call.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.nsh text eol=crlf

*.png binary
*.ico binary
*.jsonl binary

{
  "name": "sereno",
  "version": "1.2.2",
  "private": true,
  "description": "Sereno - an always-on-top widget for live Claude Code sessions",
  "author": {
    "name": "Roberto Rosado",
    "email": "roberto.d.rosado@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/homestockr/sereno",
  "repository": {
    "type": "git",
    "url": "https://github.com/homestockr/sereno.git"
  },
  "bugs": {
    "url": "https://github.com/homestockr/sereno/issues"
  },
  "keywords": [
    "claude-code",
    "electron",
    "widget",
    "hud",
    "always-on-top",
    "windows"
  ],
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node tools/serve.js",
    "wire": "node tools/wire.js",
    "unwire": "node tools/unwire.js",
    "replay": "node tools/replay.js",
    "test": "node tools/test.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "test:packaged": "node tools/test-packaged.js"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@44.3.0": true
  },
  "build": {
    "appId": "com.sereno.widget",
    "productName": "Sereno",
    "copyright": "Copyright (c) 2026 Roberto Rosado",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "bin/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**/*",
      "src/focus-window.ps1"
    ],
    "extraResources": [
      {
        "from": "bin/emit.cmd",
        "to": "emit.cmd"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sereno",
      "uninstallDisplayName": "Sereno",
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
